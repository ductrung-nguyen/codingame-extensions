{
  "manifest_version": 3,
  "name": "CodinGame Sync Bridge",
  "description": "Bridges CodinGame in-browser editor with the local VS Code environment.",
  "version": "0.1.5",
  "action": {
    "default_title": "CodinGame Sync Bridge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["https://www.codingame.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.codingame.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1:*/*", "https://localhost:*/*"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["page-script.js"],
      "matches": ["https://www.codingame.com/*"]
    }
  ]
}
